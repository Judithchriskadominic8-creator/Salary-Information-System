import java.util.Scanner;

public class SalaryInformationSystem {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        int option;

        while(true) {
            System.out.println("------------------------------------------------");
            System.out.println("| SALARY INFORMATION SYSTEM |");
            System.out.println("------------------------------------------------");
            System.out.println("[1] Calculate Income Tax");
            System.out.println("[2] Calculate Annual Bonus");
            System.out.println("[3] Calculate Loan amount");
            System.out.print("\nEnter an option to continue > ");

            option = input.nextInt();
            input.nextLine(); 

            switch(option) {
                case 1:
                    calculateIncomeTax(input);
                    break;
                case 2:
                    calculateAnnualBonus(input);
                    break;
                case 3:
                    calculateLoanAmount(input);
                    break;
                default:
                    System.out.println("Invalid option! Please enter 1, 2 or 3.");
            }
            System.out.println("\n");
        }
    }

   //(01)Calculate Income Tax
    public static void calculateIncomeTax(Scanner input) {
        System.out.println("------------------------------------------------");
        System.out.println("| Calculate Income Tax |");
        System.out.println("------------------------------------------------");

        System.out.print("Input Employee name - ");
        String name = input.nextLine();

        System.out.print("Input Employee salary - ");
        double salary = input.nextDouble();

        double tax = 0;

        
        if(salary <= 100000) {
            tax = 0;
        } else if(salary <= 141667) {
            tax = (salary - 100000) * 0.06;
        } else if(salary <= 183333) {
            tax = 2500 + (salary - 141667) * 0.12;
        } else if(salary <= 225000) {
            tax = 7500 + (salary - 183333) * 0.18;
        } else if(salary <= 266667) {
            tax = 15000 + (salary - 225000) * 0.24;
        } else if(salary <= 308333) {
            tax = 25000 + (salary - 266667) * 0.30;
        } else {
            tax = 37500 + (salary - 308333) * 0.36;
        }

        tax = Math.round(tax);
        System.out.println("\nYou have to pay Income Tax per month: " + (int)tax);
    }

    //(02)Calculate Annual Bouns 
    public static void calculateAnnualBonus(Scanner input) {
        System.out.println("------------------------------------------------");
        System.out.println("| Calculate Annual Bonus |");
        System.out.println("------------------------------------------------");

        System.out.print("Input Employee name - ");
        String name = input.nextLine();

        System.out.print("Input Employee salary - ");
        double salary = input.nextDouble();

        double bonus = 0;

        
        if(salary < 100000) {
            bonus = 5000;
        } else if(salary <= 199999) {
            bonus = salary * 0.10;
        } else if(salary <= 299999) {
            bonus = salary * 0.15;
        } else if(salary <= 399999) {
            bonus = salary * 0.20;
        } else {
            bonus = salary * 0.35;
        }

        System.out.println("Annual bonus - " + bonus);
    }

    //(03)Calculate Leon amount
    public static void calculateLoanAmount(Scanner input) {
        System.out.println("------------------------------------------------");
        System.out.println("| Calculate Loan amount |");
        System.out.println("-----------------Employee name --------------------------------");

        System.out.print("Input ");
        String name = input.nextLine();

        System.out.print("Input Employee salary - ");
        double salary = input.nextDouble();

        
        if(salary <= 50000) {
            System.out.println(" You can not get a loan because your salary lessthan Rs.50 000...");
            return;
        }

        System.out.print("Enter number of year : ");
        int years = input.nextInt();

        // Max 5 years
        if(years > 5) {
            years = 5;
        }

        double r = 0.15; 
        double monthlyInstallment = salary * 0.60; 
        int n = years * 12; 

        
        double loanAmount = monthlyInstallment * (1 - (1 / Math.pow(1 + (r/12), n))) / (r/12);

        
        loanAmount = Math.round(loanAmount / 1000.0) * 1000.0;

        System.out.println("You can get Loan Amount : " + (int)loanAmount);
    }
}
